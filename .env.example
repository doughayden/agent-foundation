### ===========================================
### Required Configuration
### ===========================================

### Google Cloud Vertex AI Model Authentication (_LOCATION refers to the model endpoint location, not the deployment region)
GOOGLE_GENAI_USE_ENTERPRISE=TRUE
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=global

### Unique agent identifier for cloud resources, logs, and traces
AGENT_NAME=agent-foundation

### GenAI message content capture: NO_CONTENT, EVENT_ONLY, SPAN_ONLY or SPAN_AND_EVENT - see docs/observability.md
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=SPAN_AND_EVENT
### With NO_CONTENT, also keep live streaming content out of telemetry
# ADK_CAPTURE_MESSAGE_CONTENT_IN_SPANS=false


### ===========================================
### Cloud Resources (Recommended)
### Production-ready persistence for sessions, memory, and artifacts
### Get values from: GitHub Actions job summary or GCP Console after first deployment
### ===========================================

### Bastion host for IAP tunnel (required for docker-compose Cloud SQL connectivity)
# BASTION_INSTANCE=agent-name-dev-bastion
# BASTION_ZONE=us-central1-b

### Session service (Cloud SQL via Auth Proxy)
# SESSION_SERVICE_URI=postgresql+asyncpg://SA_NAME@PROJECT.iam:@localhost:5432/agent_sessions

### Memory service (Agent Engine)
# MEMORY_SERVICE_URI=agentengine://projects/YOUR_PROJECT_ID/locations/YOUR_LOCATION/reasoningEngines/YOUR_ENGINE_ID

### Artifact storage via GCS bucket
# ARTIFACT_SERVICE_URI=gs://YOUR_BUCKET_NAME


### ===========================================
### Optional Agent App Runtime Configuration
### ===========================================

### Logging verbosity (default: INFO)
# LOG_LEVEL=DEBUG

### OpenTelemetry resource attributes, comma-separated key=value pairs (default: unset)
### Set a unique service.namespace so teammates can filter to your traces and logs
# OTEL_RESOURCE_ATTRIBUTES=service.name=my-agent,service.namespace=local-developer-unique-name

### Enable ADK web UI at http://localhost:8000 (default: FALSE)
# SERVE_WEB_INTERFACE=TRUE

### Enable ADK web to hot-reload agents on file changes - development only (default: FALSE)
# RELOAD_AGENTS=TRUE

### CORS allowed origins - JSON array string (default: ["http://127.0.0.1:8000", "http://localhost:8000"])
# ALLOW_ORIGINS='["https://your-frontend.com", "http://localhost:3000", "http://127.0.0.1:3000"]'

### Add ADK's adk.experimental.* metrics and span data (default: FALSE)
ADK_EXPERIMENTAL_TELEMETRY=TRUE

### Suppress ADK experimental feature warnings (default: FALSE)
# ADK_SUPPRESS_EXPERIMENTAL_FEATURE_WARNINGS=TRUE
